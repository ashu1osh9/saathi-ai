# Private single-user evaluator demo. Copy to .env.production locally; never commit real values.
# Domain only (no https://, path or port); point its DNS to the deployment server.
SAATHI_DOMAIN=
SAATHI_DEMO_USER=
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Use single quotes around the resulting bcrypt hash to preserve literal $ characters.
SAATHI_DEMO_PASSWORD_HASH=''
# Generate at least 32 random characters; see DEPLOYMENT.md. Never send this to browsers.
SAATHI_PROXY_TOKEN=
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
